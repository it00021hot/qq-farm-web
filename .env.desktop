# Desktop (Wails) build — API is in-process Fiber on loopback
VITE_IS_DESKTOP=Y
VITE_SERVICE_BASE_URL=http://127.0.0.1:9528

VITE_HTTP_PROXY=N
VITE_ROUTER_HISTORY_MODE=hash

VITE_AUTH_ROUTE_MODE=static
VITE_STATIC_SUPER_ROLE=role_superadmin

VITE_AUTOMATICALLY_DETECT_UPDATE=N
VITE_PROXY_LOG=N

VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://127.0.0.1:9528"
}`
